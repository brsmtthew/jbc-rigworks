{
  "name": "jbc-rigworks",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "npm run test:logic",
    "test:rules": "firebase emulators:exec --project demo-jbc-rigworks --only firestore \"node --test tests/database/firestore.rules.mjs\"",
    "test:database": "firebase emulators:exec --project demo-jbc-rigworks --only auth,firestore \"node --test tests/database/v2.mjs\"",
    "preview": "vite preview",
    "test:logic": "node --import ./tests/logic/register.mjs --test tests/logic/*.test.mjs",
    "test:ui": "node --test --test-concurrency=1 tests/ui/layout.mjs tests/ui/admin-controls.mjs",
    "test:integration": "npm run test:rules && npm run test:database",
    "format": "prettier --write src tests docs README.md \"*.{json,js,ts}\"",
    "format:check": "prettier --check src tests docs README.md \"*.{json,js,ts}\""
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@zxing/browser": "^0.2.1",
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "lucide-react": "^1.47.0",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prettier": "^3.9.9",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
