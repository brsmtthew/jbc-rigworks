rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function profilePath() {
      return /databases/$(database)/documents/users/$(request.auth.uid);
    }

    function isAdmin() {
      return verified() && exists(profilePath()) &&
        get(profilePath()).data.role == 'admin';
    }

    function validProfile(data) {
      return data.keys().hasAll(['name', 'email', 'role', 'createdAt']) &&
        data.keys().hasOnly(['name', 'email', 'role', 'createdAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 80 &&
        data.email is string && data.email == request.auth.token.email &&
        data.role in ['user', 'admin'] &&
        data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if signedIn() && request.auth.uid == uid &&
        validProfile(request.resource.data) &&
        request.resource.data.role == 'user' &&
        request.resource.data.createdAt == request.time;
      allow update: if signedIn() && request.auth.uid == uid &&
        validProfile(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.role == resource.data.get('role', 'user') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'role']);
      allow delete: if false;

      match /settings/{settingId} {
        allow read, write: if signedIn() && request.auth.uid == uid && settingId == 'account';
      }

      match /plans/{planId} {
        allow get: if signedIn() && request.auth.uid == uid;
        allow list, delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
        allow create, update: if signedIn() && request.auth.uid == uid &&
          request.resource.data.id == planId;
      }
    }

    match /settings/{settingId} {
      allow read: if signedIn() && settingId in ['shop', 'directories'];
      allow create, update: if isAdmin() && settingId in ['shop', 'directories'];
      allow delete: if isAdmin() && settingId in ['shop', 'directories'];
    }

    match /stockMovements/{id} {
      allow read, create: if isAdmin();
      allow update: if false;
      allow delete: if isAdmin();
    }
    match /orderSnapshots/{id} { allow read, write: if isAdmin(); }
    match /appointmentSlots/{id} {
      function pairedAppointment(appointmentId) {
        return getAfter(/databases/$(database)/documents/appointments/$(appointmentId)).data;
      }
      function validClaim() {
        let data = request.resource.data;
        let appointmentId = data.lastAppointmentId;
        let appointment = pairedAppointment(appointmentId);
        return signedIn() && appointmentId is string &&
          data.keys().hasOnly(['id', 'date', 'windowId', 'count', 'holds', 'lastAppointmentId']) &&
          data.id == id && data.date + '_' + data.windowId == id &&
          appointment.customerId == request.auth.uid && appointment.status == 'Requested' &&
          appointment.slotId == id && data.count == 1 &&
          data.holds.keys().hasOnly([appointmentId]) && data.holds[appointmentId] == request.auth.uid;
      }
      function validChange() {
        let data = request.resource.data;
        let appointmentId = data.lastAppointmentId;
        let before = resource.data.get('holds', {});
        let after = data.get('holds', {});
        let appointment = pairedAppointment(appointmentId);
        return signedIn() && appointmentId is string &&
          data.diff(resource.data).affectedKeys().hasOnly(['count', 'holds', 'lastAppointmentId']) &&
          after.diff(before).affectedKeys().hasOnly([appointmentId]) &&
          appointment.customerId == request.auth.uid &&
          ((before.get(appointmentId, '') != request.auth.uid &&
            after.get(appointmentId, '') == request.auth.uid &&
            appointment.status == 'Requested' && appointment.slotId == id &&
            data.count == resource.data.count + 1) ||
           (before.get(appointmentId, '') == request.auth.uid &&
            !after.keys().hasAny([appointmentId]) &&
            (appointment.status == 'Cancelled' || appointment.slotId != id) &&
            data.count == resource.data.count - 1));
      }
      allow read: if signedIn();
      allow create: if isAdmin() || validClaim();
      allow update: if isAdmin() || validChange();
      allow delete: if isAdmin();
    }

    match /inventory/{id} {
      function hasSkuClaim() {
        return request.resource.data.skuKey is string &&
          getAfter(/databases/$(database)/documents/inventorySkus/$(request.resource.data.skuKey)).data.itemId == id;
      }
      allow read: if isAdmin();
      allow create: if isAdmin() && hasSkuClaim() && validInventory();
      allow update: if isAdmin() && validInventory() &&
        ((request.resource.data.sku == resource.data.sku && request.resource.data.get('skuKey', '') == resource.data.get('skuKey', '')) || hasSkuClaim());
      function validInventory() {
        return request.resource.data.id == id &&
        request.resource.data.stock is int && request.resource.data.stock >= 0 &&
        request.resource.data.get('reserved', 0) is int && request.resource.data.get('reserved', 0) >= 0 &&
        request.resource.data.get('reserved', 0) <= request.resource.data.stock &&
        request.resource.data.cost is number && request.resource.data.cost >= 0 &&
        request.resource.data.price is number && request.resource.data.price >= 0;
      }
      allow delete: if isAdmin();
    }

    match /inventorySkus/{key} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.itemId is string &&
        getAfter(/databases/$(database)/documents/inventory/$(request.resource.data.itemId)).data.skuKey == key;
      allow update: if isAdmin() && request.resource.data.itemId == resource.data.itemId;
      allow delete: if isAdmin();
    }

    match /catalog/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /bundles/{id} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /jobs/{id} {
      allow read, create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /expenses/{id} {
      allow read: if isAdmin();
      allow create, update: if isAdmin() && request.resource.data.amount is number && request.resource.data.amount >= 0;
      allow delete: if isAdmin();
    }

    match /sales/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.id == id && request.resource.data.status == 'Paid' && request.resource.data.paid == request.resource.data.total && request.resource.data.total >= 0;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /orders/{id} {
      function submittingOwnProof() {
        let proof = getAfter(/databases/$(database)/documents/paymentProofs/$(id)).data;
        return signedIn() && resource.data.customerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['paymentStatus']) &&
          request.resource.data.paymentStatus == 'Pending verification' &&
          resource.data.paid < resource.data.total &&
          !(resource.data.orderStatus in ['Cancelled', 'Declined']) &&
          proof.customerId == request.auth.uid && proof.orderId == id && proof.status == 'Pending';
      }
      allow get, list: if isAdmin() ||
        (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isAdmin() || (signedIn() &&
        request.resource.data.id == id &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.channel == 'Online' &&
        request.resource.data.orderStatus == 'Requested' &&
        request.resource.data.status == 'Unpaid' &&
        request.resource.data.get('reservationState', 'None') == 'None' &&
        request.resource.data.get('paymentStatus', 'Unpaid') == 'Unpaid' &&
        request.resource.data.paid == 0 &&
        request.resource.data.cost == 0 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 && request.resource.data.total <= 10000000 &&
        request.resource.data.lines is list &&
        request.resource.data.lines.size() > 0 && request.resource.data.lines.size() <= 50 &&
        request.resource.data.paymentMethod in ['Cash', 'Bank transfer', 'E-wallet'] &&
        request.resource.data.fulfillment.mode in ['Pickup', 'Delivery'] &&
        (request.resource.data.fulfillment.mode == 'Pickup' || (request.resource.data.fulfillment.address is string && request.resource.data.fulfillment.address.size() > 0 && request.resource.data.contact is string && request.resource.data.contact.size() > 0)) &&
        request.resource.data.receiptEmail is string &&
        request.resource.data.receiptEmail.size() > 0 && request.resource.data.receiptEmail.size() <= 254 &&
        !request.resource.data.keys().hasAny(['serviceJobId', 'buildId', 'cashTendered', 'change', 'lastReceiptId', 'paidAt']) &&
        request.resource.data.paymentHistory.size() == 0);
      allow update: if isAdmin() || submittingOwnProof() || (signedIn() &&
        resource.data.customerId == request.auth.uid &&
        resource.data.get('orderStatus', 'Requested') == 'Requested' && resource.data.paid == 0 &&
        ((request.resource.data.get('orderStatus', 'Requested') == 'Requested' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['customer', 'contact', 'receiptEmail', 'notes', 'fulfillment']) &&
          request.resource.data.customer is string && request.resource.data.customer.size() > 0 && request.resource.data.customer.size() <= 120 &&
          request.resource.data.contact is string && request.resource.data.contact.size() <= 100 &&
          request.resource.data.receiptEmail is string && request.resource.data.receiptEmail.size() > 0 && request.resource.data.receiptEmail.size() <= 254 &&
          request.resource.data.notes is string && request.resource.data.notes.size() <= 1000 &&
          request.resource.data.fulfillment.diff(resource.data.fulfillment).affectedKeys().hasOnly(['address']) &&
          request.resource.data.fulfillment.get('address', '') is string && request.resource.data.fulfillment.get('address', '').size() <= 400 &&
          (resource.data.fulfillment.mode == 'Pickup' ||
            (request.resource.data.fulfillment.get('address', '').size() > 0 && request.resource.data.contact.size() > 0))) ||
         (request.resource.data.orderStatus == 'Cancelled' &&
          request.resource.data.cancelledBy == request.auth.uid &&
          request.resource.data.cancelledAt is string &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderStatus', 'cancelledBy', 'cancelledAt']))));
      allow delete: if isAdmin();
    }

    match /paymentAccounts/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /paymentProofs/{id} {
      function ownOrder() {
        return signedIn() && get(/databases/$(database)/documents/orders/$(id)).data.customerId == request.auth.uid;
      }
      function validProof() {
        let data = request.resource.data;
        let order = get(/databases/$(database)/documents/orders/$(id)).data;
        let account = get(/databases/$(database)/documents/paymentAccounts/$(data.accountId)).data;
        return ownOrder() && data.keys().hasOnly(['id', 'orderId', 'customerId', 'accountId', 'method', 'amount', 'reference', 'image', 'submittedAt', 'status']) &&
          data.id == id && data.orderId == id && data.customerId == request.auth.uid &&
          data.status == 'Pending' && !(order.orderStatus in ['Declined', 'Cancelled']) &&
          data.amount is number && data.amount > 0 &&
          data.amount >= order.total - order.paid - 0.000001 && data.amount <= order.total - order.paid + 0.000001 &&
          account.get('customers', true) == true && account.enabled == true && account.qrImage.size() > 0 && data.method == account.kind &&
          data.reference is string && data.reference.size() > 0 && data.reference.size() <= 100 &&
          data.submittedAt is string && data.image is string && data.image.size() <= 700000 &&
          data.image.matches('data:image/(png|jpeg|webp);base64,.*');
      }
      allow get: if isAdmin() || ownOrder();
      allow list: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn() && validProof();
      allow update: if isAdmin() || (signedIn() && resource.data.status == 'Rejected' && validProof());
      allow delete: if isAdmin();
    }

    match /receipts/{id} {
      allow get, list: if isAdmin() || (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if isAdmin() && request.resource.data.id == id;
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /receiptEmails/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.receiptId == id && request.resource.data.status == 'Queued';
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /appointments/{id} {
      function validServiceIntake() {
        let intake = request.resource.data.get('serviceIntake', {});
        return !request.resource.data.keys().hasAny(['visit']) ||
          (intake is map &&
            intake.get('customerName', '') is string && intake.get('customerName', '').size() > 0 &&
            intake.get('contactPhone', '') is string && intake.get('contactPhone', '').size() > 0 &&
            intake.get('deviceType', '') in ['Desktop PC', 'Laptop'] &&
            intake.get('serviceType', 'general') in ['general', 'assembly', 'diagnosis', 'upgrade'] &&
            intake.get('visibleDamage', []) is list &&
            intake.get('visibleCondition', '') is string && intake.get('visibleCondition', '').size() > 0 &&
            intake.get('reportedIssues', '') is string &&
            intake.get('issueHistory', '') is string &&
            (intake.get('serviceType', 'general') != 'general' ||
              (intake.get('reportedIssues', '').size() > 0 && intake.get('issueHistory', '').size() > 0)) &&
            (intake.get('serviceType', 'general') != 'diagnosis' || intake.get('issueHistory', '').size() > 0) &&
            (intake.get('serviceType', 'general') != 'assembly' ||
              (intake.get('assemblyParts', '') is string && intake.get('assemblyParts', '').size() > 0 &&
               intake.get('assemblyGoal', '') is string && intake.get('assemblyGoal', '').size() > 0)) &&
            (intake.get('serviceType', 'general') != 'diagnosis' ||
              (intake.get('diagnosisSymptoms', '') is string && intake.get('diagnosisSymptoms', '').size() > 0)) &&
            (intake.get('serviceType', 'general') != 'upgrade' ||
              (intake.get('upgradeCurrent', '') is string && intake.get('upgradeCurrent', '').size() > 0 &&
               intake.get('upgradeTarget', '') is string && intake.get('upgradeTarget', '').size() > 0)) &&
            intake.get('powerStatus', '') in ['Powers on', 'Intermittent', 'Does not power on', 'Not tested'] &&
            intake.get('liquidExposure', '') in ['Yes', 'No', 'Unsure'] &&
            intake.get('backupStatus', '') in ['Backed up', 'Not backed up', 'Not applicable', 'Unsure']);
      }
      allow get, list: if isAdmin() ||
        (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.id == id &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.customerEmail == request.auth.token.email &&
        request.resource.data.status == 'Requested' &&
        !request.resource.data.keys().hasAny(['jobId', 'cancelledBy', 'cancelledAt', 'reviewedEstimate', 'reviewNote', 'scheduleHistory', 'intakeSignedAt', 'intakeSignedBy']) && request.resource.data.device is string && request.resource.data.preferredDate is string && validServiceIntake() &&
        (!request.resource.data.keys().hasAny(['visit']) ||
          (request.resource.data.slotId is string &&
           getAfter(/databases/$(database)/documents/appointmentSlots/$(request.resource.data.slotId)).data.holds[id] == request.auth.uid));
      allow update: if isAdmin() || (signedIn() &&
        resource.data.customerId == request.auth.uid &&
        resource.data.status == 'Requested' &&
        !resource.data.keys().hasAny(['reviewNote']) &&
        ((request.resource.data.status == 'Requested' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'preferredDate', 'preferredTime', 'device', 'specifications', 'unknownSpecifications', 'serviceIntake', 'visit', 'slotId']) &&
          validServiceIntake() &&
          (!request.resource.data.keys().hasAny(['visit']) ||
            (request.resource.data.slotId is string &&
             getAfter(/databases/$(database)/documents/appointmentSlots/$(request.resource.data.slotId)).data.holds[id] == request.auth.uid)) &&
          (!resource.data.keys().hasAny(['slotId']) || request.resource.data.slotId == resource.data.slotId ||
            !getAfter(/databases/$(database)/documents/appointmentSlots/$(resource.data.slotId)).data.get('holds', {}).keys().hasAny([id])) &&
          (!request.resource.data.keys().hasAny(['visit']) ||
            request.resource.data.visit.diff(resource.data.visit).affectedKeys().hasOnly(['address']))) ||
         (request.resource.data.status == 'Cancelled' && request.resource.data.cancelledBy == request.auth.uid && request.resource.data.cancelledAt is string && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'cancelledAt', 'cancellationReason']) &&
          (!resource.data.keys().hasAny(['slotId']) ||
            !getAfter(/databases/$(database)/documents/appointmentSlots/$(resource.data.slotId)).data.get('holds', {}).keys().hasAny([id])))));
      allow delete: if isAdmin();
    }

    match /pcRequests/{id} {
      allow get, list: if isAdmin() ||
        (signedIn() && resource.data.customerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.id == id &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.customerEmail == request.auth.token.email &&
        request.resource.data.status in ['Under review', 'Quote requested'] &&
        !request.resource.data.keys().hasAny(['quote', 'transactionId']) && request.resource.data.get('reservationState', 'None') == 'None';
      allow update: if isAdmin() || (signedIn() &&
        resource.data.customerId == request.auth.uid &&
        ((resource.data.status == 'Quote requested' &&
          ((request.resource.data.status == 'Quote requested' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notes', 'parts', 'tier', 'useCase', 'budget', 'processor', 'graphics', 'memory', 'storage'])) || (request.resource.data.status == 'Cancelled' && request.resource.data.cancelledBy == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'cancelledBy', 'cancelledAt'])))) ||
         (resource.data.status == 'Quoted' &&
          ((request.resource.data.status == 'Declined' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
           (request.resource.data.status == 'Approved' &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAt', 'approvedBy', 'approvalNote']) &&
            request.resource.data.approvedAt is string &&
            request.resource.data.approvedAt.size() <= 40 &&
            request.resource.data.approvedBy == request.auth.uid &&
            request.resource.data.approvalNote == 'Approved in customer portal.')))));
      allow delete: if isAdmin();
    }
  }
}
