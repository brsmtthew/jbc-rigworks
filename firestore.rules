rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function verified() {
      return signedIn() && request.auth.token.email_verified == true;
    }

    function adminPath() {
      return /databases/$(database)/documents/config/adminAccount;
    }

    function companyEmail() {
      return verified() && request.auth.token.email is string &&
        request.auth.token.email.lower() == 'jbcrigworks@gmail.com';
    }

    function isAdmin() {
      return companyEmail() && exists(adminPath()) &&
        get(adminPath()).data.uid == request.auth.uid;
    }

    function validProfile(data) {
      return data.keys().hasAll(['name', 'email', 'createdAt']) &&
        data.keys().hasOnly(['name', 'email', 'createdAt']) &&
        data.name is string && data.name.size() > 0 && data.name.size() <= 80 &&
        data.email is string && data.email == request.auth.token.email &&
        data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow list: if isAdmin();
      allow create: if verified() && request.auth.uid == uid &&
        validProfile(request.resource.data) &&
        request.resource.data.createdAt == request.time;
      allow update: if verified() && request.auth.uid == uid &&
        validProfile(request.resource.data) &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email']);
      allow delete: if false;
    }

    match /config/adminAccount {
      allow get: if companyEmail();
      allow list, create, update, delete: if false;
    }
  }
}
